---
const { site } = Astro.props
---
<section id="top" class="hero">
    <div class="hero-content">
        <img
            src="/hero_photo.jpg"
            alt="Alexander Cantoral profile photo"
            class="avatar"
            width="120"
            height="120"
            loading="lazy"
            decoding="async"
        />

        <h1>{site.name}</h1>
        <p class="subtitle">{site.title}</p>

        <p class="hero-description">{site.description}</p>

        <p class="contact-info">
            <a href={`mailto:${site.email}`}>{site.email}</a>
        </p>

        <div class="hero-actions">
            <a class="button" href={site.github} target="_blank" rel="noopener noreferrer">GitHub</a>
            <a class="button button-secondary" href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
        </div>
    </div>
</section>