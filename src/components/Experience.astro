---
const experience = [
    {
        role: 'Developer I',
        company: 'Avatar Global',
        period: '2026',
        modality: 'E-commerce / SFCC',
        tech: ['Salesforce Commerce Cloud', 'SFRA', 'JavaScript', 'QA'],
        responsibilities: [
            'Implemented and maintained e-commerce features for Salesforce Commerce Cloud/SFRA projects.',
            'Fixed bugs, updated UI styles, and added frontend/backend validations for user stories.',
            'Supported QA/UAT cycles, reviewed dataLayer events, and prepared commits/PRs with team standards.',
            'Worked with architects, analysts, and developers to ensure acceptance criteria and code quality.'
        ]
    },
    {
        role: 'Frontend Web Intern',
        company: 'NEONHOUSELED S.A.C',
        period: 'Jun 2025 – Sep 2025',
        modality: 'Remote Internship (Certified)',
        tech: ['React', 'Laravel', 'MySQL'],
        responsibilities: [
            'Developed new frontend features for company websites and web applications',
            'Maintained and improved existing pages and components',
            'Proposed solutions to improve workflow efficiency and overall usability',
            'Collaborated with backend developers and designers in an agile environment',
            'Completed certified internship and received a recommendation letter'
        ]
    }
]
---
<section id="experience" class="container">
    <h2>Professional Experience</h2>

    {experience.map(item => (
        <article class="experience-card">
            <header>
                <h3>{item.role}</h3>
                <p class="meta">
                    {item.company} · {item.period}
                </p>
                <p class="sub-meta">{item.modality}</p>
            </header>

            <ul class="experience-list">
                {item.responsibilities.map(point => (
                    <li>{point}</li>
                ))}
            </ul>

            <ul class="tech-list">
                {item.tech.map(t => <li>{t}</li>)}
            </ul>
        </article>
    ))}
</section>